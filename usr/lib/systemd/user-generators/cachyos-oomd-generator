# Mark all slices of the user manager as systemd-oomd kill candidates.
#
# This cannot be a static drop-in: to resolve ManagedOOM*=kill the manager
# reads /proc/1/cgroup. If procfs hides PID 1 (hidepid=), that fails with
# ESRCH and makes every slice, and so the whole user session, unloadable.
[[ -n "$1" ]] || exit 1
cat /proc/1/cgroup &>/dev/null || exit 0

mkdir -p "$1/slice.d"
cat > "$1/slice.d/10-oomd-per-slice-defaults.conf" <<CONF
# Automatically generated by cachyos-oomd-generator
[Slice]
ManagedOOMSwap=kill
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=80%
CONF
